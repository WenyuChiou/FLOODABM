# Generated artifacts
outputs/
data/*
fig/
logs/
cache/

# Published supplementary data (cited in the Supporting Information)
!data/supplementary/
!data/figures/
data/figures/*

# Keep folder markers
!outputs/.gitkeep
!data/.gitkeep
!fig/.gitkeep
!logs/.gitkeep

# Models: keep baseline_fast (posterior-mean cache) and the baseline posterior
# samples + calibrators (npz only; the large .pkl stay ignored via *.pkl below).
models/**
!models/baseline_fast/
!models/baseline_fast/*.npz
!models/baseline/
!models/baseline/*.npz
!models/baseline/best_calibrators.json

# Archive (legacy scripts)
archive/

# Python
__pycache__/
*.py[cod]
*.pyo
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# IDE / editor / AI session
.vscode/
.idea/
.claude/
.ai/

# Logs
*.log

# Large data files
*.csv
!config/sfha_area_share_by_tract.csv
!config/initial_fi_summary.csv
!data/supplementary/*.csv
!data/figures/Figure8_adaptation_trajectories.csv
!data/figures/Figure11_income_aep.csv
!data/figures/Figure5_metrics_corrected_county_labels.csv
!data/figures/Figure5_nfip_validation_corrected_county_labels.csv
!data/figures/Figure6_cumulative_loss.csv
!data/figures/Figure6_annual_finance.csv
!data/figures/Figure7_aep.csv
!data/figures/Figure9_tp_by_prone.csv
!data/figures/FigureS4_action_threshold_intervals.csv
!data/figures/FigureS5_gul_ratio_threshold.csv
!data/figures/FigureS6_flood_event_sequence.csv
*.parquet
*.pkl
*.h5
*.feather

# Calibration pipeline: allow code and model weights; ignore regenerable outputs
!calibration/
!calibration/**
# Local survey workbooks are optional calibration inputs, not benchmark inputs.
calibration/data/*.xls*
# phase1 outputs (regenerable via plot_action_distributions.py + generate_report.py)
calibration/phase1_tenure_distributions/*.png
calibration/phase1_tenure_distributions/*.csv
calibration/phase1_tenure_distributions/*.docx
# phase2 outputs (regenerable via bayesian_engine); the shared posteriors are in models/baseline/
calibration/phase2_bayesian_regression/models/*.npz
calibration/phase2_bayesian_regression/*.png
calibration/phase2_bayesian_regression/*.xlsx
calibration/phase2_bayesian_regression/owner_group/**/*.xlsx
calibration/phase2_bayesian_regression/renter_group/**/*.xlsx
# phase3 outputs (regenerable via run_calibration.py + core/visualizer.py)
# keep: tp_decay_params_for_abm.json (optional calibration reports read it)
calibration/phase3_tp_decay/outputs/*.png
calibration/phase3_tp_decay/outputs/*.xlsx
calibration/phase3_tp_decay/outputs/*.csv

# Misc
_UL
*.pdf
